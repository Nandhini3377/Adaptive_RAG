# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Sarvam API key (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Neo4j (Phase 3: docker compose up)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional: Langfuse Cloud tracing (skipped when empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Production only (see docker-compose.prod.yml)
# CORS_ORIGINS=["https://your-app.vercel.app"]
# REGISTRATION_ENABLED=false
# API_DOCS_ENABLED=false
